rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Career applications collection
    match /career_applications/{applicationId} {
      // Allow anyone to create a new application (for form submission)
      allow create: if request.auth == null 
        && request.resource.data.keys().hasAll(['name', 'email', 'position_applied', 'resume_url', 'submitted_at'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.position_applied is string
        && request.resource.data.resume_url is string;
      
      // Only authenticated admin users can read, update, or delete
      allow read, update, delete: if request.auth != null;
    }
    
    // Contact submissions collection
    match /contact_submissions/{submissionId} {
      // Allow anyone to create a new submission (for form submission)
      allow create: if request.auth == null 
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'submitted_at'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string;
      
      // Only authenticated admin users can read, update, or delete
      allow read, update, delete: if request.auth != null;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

